#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUNTIME="$ROOT/lib/rabbitmq"

for candidate in \
  "$RUNTIME/lib/rabbitmq/sbin/rabbitmqctl" \
  "$RUNTIME/sbin/rabbitmqctl" \
  "$RUNTIME/bin/rabbitmqctl"
do
  if [[ -x "$candidate" ]]; then
    export PATH="$RUNTIME/bin:$RUNTIME/sbin:$RUNTIME/lib/rabbitmq/sbin:$PATH"
    exec "$candidate" "$@"
  fi
done

candidate="$(find "$RUNTIME" -name rabbitmqctl -perm -u+x -print -quit 2>/dev/null || true)"
if [[ -n "$candidate" ]]; then
  export PATH="$RUNTIME/bin:$RUNTIME/sbin:$RUNTIME/lib/rabbitmq/sbin:$PATH"
  exec "$candidate" "$@"
fi

echo "ERROR: rabbitmqctl was not found in $RUNTIME" >&2
exit 1
